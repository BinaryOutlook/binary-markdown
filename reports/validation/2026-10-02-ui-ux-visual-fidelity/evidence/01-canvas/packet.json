  "title": "Writing canvas and visual hierarchy",
  "designCommit": "a798921f7e5a9b01a88360315b035a391f69da47",
  "contractHash": "6a49fa68b56b31cae2ecb755cf2986d4dc9e20fc4f48b544e02c0560c95bb13c",
  "designBrief": "Consistent minimalist Binary Markdown desktop-editor language. Flat off-white canvas #FAFAF8, pale neutral rail #F3F4F5, charcoal text #242830, one restrained blue accent #4266B0. For dark subjects use charcoal #1B1E26 and slate surfaces #272D38 with legible pale tokens and the same blue accent. Familiar system sans typography and monospace only for source. Crisp 1px dividers, 6px corner radii, 8px spacing increments, no decorative gradients, no glass, no giant cards, no marketing art, no invented logo. Preserve the real Markdown-editor identity and useful commands. This is a proposed static design concept, not a working product. Show one option only, with readable exact short labels and synthetic research-note content.",
  "ownerAdjustments": [
    "Configured fonts, article width and alignment remain user preferences."
  ],
  "targetRegions": [
    {
      "id": "canvas",
      "description": "Writing column, heading hierarchy, prose rhythm and focus-only width guides."
    }
  ],
  "excludedRegions": [
    "toolbar",
    "outline",
    "code/table control redesign",
    "desktop chrome",
    "reference caption bands and numbered pins"
  ],
  "obstructionException": "Excluded UI matters only if it clips or obstructs this target. Never grade its independent design.",
  "criteria": [
    {
      "id": "C1",
      "description": "Calm top inset and reading measure"
    },
    {
      "id": "C2",
      "description": "Quiet heading hierarchy"
    },
    {
      "id": "C3",
      "description": "Width guidance does not compete with prose"
    }
  ],
  "requiredStates": [
    "Focused and unfocused writing",
    "Empty document",
    "Short and narrow panes"
  ],
  "references": [
    {
      "path": ".vscode-test/visual-fidelity/references/01-canvas-recommended.png",
      "sha256": "05a2b26218a1bdb28cc467168c188809a8898c352c9b5124a42dbce9fa82008d",
      "width": 1536,
      "height": 1024,
      "bytes": 1286152,
      "level": "Recommended",
      "intent": "Make the smallest practical correction: retain the outline and current full toolbar, reduce the writing canvas top inset to about 40px, use a readable 740px body measure, retain 16px body text, make H1 charcoal and H2 charcoal with restrained rules, show subtle width markers only when focused. Keep the code block and table content intact. Numbered callouts: 1 near the first heading = Less empty space before writing; 2 near heading hierarchy = Quiet, consistent typography; 3 near width marker = Guides appear when useful.",
      "annotations": [
        "Less empty space before writing: reduce the top inset while keeping a comfortable reading column",
        "Quiet hierarchy: use charcoal headings and restrained section rules",
        "Guides when useful: expose width assistance on focus rather than during ordinary reading"
      ]
    }
  ],
