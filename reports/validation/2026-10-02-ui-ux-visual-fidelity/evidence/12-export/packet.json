  "title": "Export choice, setup and recovery",
  "designCommit": "a798921f7e5a9b01a88360315b035a391f69da47",
  "contractHash": "6a49fa68b56b31cae2ecb755cf2986d4dc9e20fc4f48b544e02c0560c95bb13c",
  "designBrief": "Consistent minimalist Binary Markdown desktop-editor language. Flat off-white canvas #FAFAF8, pale neutral rail #F3F4F5, charcoal text #242830, one restrained blue accent #4266B0. For dark subjects use charcoal #1B1E26 and slate surfaces #272D38 with legible pale tokens and the same blue accent. Familiar system sans typography and monospace only for source. Crisp 1px dividers, 6px corner radii, 8px spacing increments, no decorative gradients, no glass, no giant cards, no marketing art, no invented logo. Preserve the real Markdown-editor identity and useful commands. This is a proposed static design concept, not a working product. Show one option only, with readable exact short labels and synthetic research-note content.",
  "ownerAdjustments": [
    "Work only on the Export submenu; do not introduce a separate export application or change existing saved-export contracts.",
    "Use actual host stages, bounded warnings and host-recorded completed output; do not fabricate percentages or completion."
  ],
  "targetRegions": [
    {
      "id": "export",
      "description": "Export submenu only: distinct Format/setup, actual job status, results/warnings and output/recovery actions."
    }
  ],
  "excludedRegions": [
    "main toolbar independent styling",
    "outline",
    "canvas",
    "desktop chrome outside submenu",
    "desktop chrome",
    "reference caption bands and numbered pins"
  ],
  "obstructionException": "Excluded UI matters only if it clips or obstructs this target. Never grade its independent design.",
  "criteria": [
    {
      "id": "C1",
      "description": "Distinct format/setup, job-status and output/warning sections"
    },
    {
      "id": "C2",
      "description": "Clear stage and action hierarchy"
    },
    {
      "id": "C3",
      "description": "Legible recovery and output actions"
    }
  ],
  "requiredStates": [
    "Available and missing tools",
    "Running and canceling",
    "Failure",
    "Completion with warnings",
    "Narrow panel"
  ],
