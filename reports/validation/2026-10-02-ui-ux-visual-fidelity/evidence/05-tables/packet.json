{
  "schemaVersion": 1,
  "sectionId": "05-tables",
  "title": "Contextual table controls",
  "designCommit": "a798921f7e5a9b01a88360315b035a391f69da47",
  "contractHash": "6a49fa68b56b31cae2ecb755cf2986d4dc9e20fc4f48b544e02c0560c95bb13c",
  "designBrief": "Consistent minimalist Binary Markdown desktop-editor language. Flat off-white canvas #FAFAF8, pale neutral rail #F3F4F5, charcoal text #242830, one restrained blue accent #4266B0. For dark subjects use charcoal #1B1E26 and slate surfaces #272D38 with legible pale tokens and the same blue accent. Familiar system sans typography and monospace only for source. Crisp 1px dividers, 6px corner radii, 8px spacing increments, no decorative gradients, no glass, no giant cards, no marketing art, no invented logo. Preserve the real Markdown-editor identity and useful commands. This is a proposed static design concept, not a working product. Show one option only, with readable exact short labels and synthetic research-note content.",
  "ownerAdjustments": [
    "The owner replaces the image's 2 by 2 insertion buttons with a diamond: above / left-right / below.",
    "Retain existing stored placement choices and plain Markdown semantics; record the inspector-placement adaptation before implementation."
  ],
  "targetRegions": [
    {
      "id": "table",
      "description": "Selected table, readable external row/column coordinates and boundary insertion targets."
    },
    {
      "id": "inspector",
      "description": "Existing placement-aware selection inspector: Rows/Columns navigation, Alignment group, requested diamond, destructive/placement utilities."
    }
  ],
  "excludedRegions": [
    "main toolbar independent design",
    "outline",
    "unrelated authored prose",
    "desktop chrome",
    "reference caption bands and numbered pins"
  ],
  "obstructionException": "Excluded UI matters only if it clips or obstructs this target. Never grade its independent design.",
  "criteria": [
    {
      "id": "C1",
      "description": "Readable coordinate gutters"
    },
    {
      "id": "C2",
      "description": "Grouped selection/alignment controls and the requested diamond"
    },
    {
      "id": "C3",
      "description": "Insertion targets outside authored cell content; no obstruction or clipping"
    }
  ],
  "requiredStates": [
    "Body and header selection",
    "Coordinates and boundary insertion",
    "Wide table scrolling",
    "Each saved placement",
    "Narrow pane"
  ],
  "references": [
    {
      "path": ".vscode-test/visual-fidelity/references/05-tables-experimental.png",
      "sha256": "bba8162ee5cbf9e4c8a13c68030b78a1457193e52e650808bb06af3118e975ad",
      "width": 1672,
      "height": 941,
      "bytes": 1139840,
      "level": "Experimental",
      "intent": "Explore a spreadsheet-like optional interaction: subtle row/column headers, inline plus buttons at insertion boundaries, and a small selection inspector with Rows, Columns and Alignment. Keep the document aesthetic and preserve plain Markdown table semantics. Pins: 1 direct insertion at boundaries; 2 row/column association is visible; 3 advanced operations remain in a compact inspector. No formulas or data-grid feature promises.",
      "annotations": [
        "Direct insertion at boundaries",
        "Row/column association is visible",
        "Advanced operations remain in a compact inspector"
      ]
    }
  ],
