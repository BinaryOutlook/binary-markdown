  "sectionId": "09-find",
  "title": "Find and Replace labeling and control hierarchy",
  "designCommit": "a798921f7e5a9b01a88360315b035a391f69da47",
  "contractHash": "6a49fa68b56b31cae2ecb755cf2986d4dc9e20fc4f48b544e02c0560c95bb13c",
  "designBrief": "Consistent minimalist Binary Markdown desktop-editor language. Flat off-white canvas #FAFAF8, pale neutral rail #F3F4F5, charcoal text #242830, one restrained blue accent #4266B0. For dark subjects use charcoal #1B1E26 and slate surfaces #272D38 with legible pale tokens and the same blue accent. Familiar system sans typography and monospace only for source. Crisp 1px dividers, 6px corner radii, 8px spacing increments, no decorative gradients, no glass, no giant cards, no marketing art, no invented logo. Preserve the real Markdown-editor identity and useful commands. This is a proposed static design concept, not a working product. Show one option only, with readable exact short labels and synthetic research-note content.",
  "ownerAdjustments": [
    "Work only on the Find/Replace submenu surface; outer placement may adapt to that scope while retaining the chosen internal hierarchy.",
    "Preserve bounded regex execution, literal replacement and shared undo."
  ],
  "targetRegions": [
    {
      "id": "find",
      "description": "Find/Replace submenu only: persistent field labels, replacement hierarchy, scope/selected count, contextual result cards."
    },
    {
      "id": "highlights",
      "description": "Only the association of Find result selection with document match highlights; ignore canvas styling."
    }
  ],
  "excludedRegions": [
    "main toolbar",
    "outline",
    "export",
    "canvas typography/content except target highlights",
    "desktop chrome",
    "reference caption bands and numbered pins"
  ],
  "obstructionException": "Excluded UI matters only if it clips or obstructs this target. Never grade its independent design.",
  "criteria": [
    {
      "id": "C1",
      "description": "Persistent visible field-purpose labels"
    },
    {
      "id": "C2",
      "description": "Clear replacement/action hierarchy and readable contextual results"
    },
    {
      "id": "C3",
      "description": "Selected-target clarity and associated document highlights"
    }
  ],
  "requiredStates": [
    "Filled Find and Replace fields",
    "Several results and selected targets",
    "No results",
    "Invalid or expensive regex",
    "Narrow pane"
  ],
