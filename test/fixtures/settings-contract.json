{
  "binary-markdown.theme": {"type": "string", "enum": ["github", "sepia", "night", "dark", "minimal", "perplexity", "things"], "default": "things"},
  "binary-markdown.fontSize": {"type": "number", "default": 16},
  "binary-markdown.imageDefaultDir": {"type": "string", "default": ""},
  "binary-markdown.forceRelativeImagePath": {"type": "boolean", "default": false},
  "binary-markdown.language": {"type": "string", "enum": ["default", "en", "ja", "zh-TW", "zh-CN", "ko", "es", "fr"], "default": "default"},
  "binary-markdown.toolbarMode": {"type": "string", "enum": ["full", "simple"], "default": "full"},
  "binary-markdown.outlineStateScope": {"type": "string", "enum": ["file", "global"], "default": "file"},
  "binary-markdown.outlineDefaultOpen": {"type": "boolean", "default": true},
  "binary-markdown.outlineActiveColor": {"type": "string", "enum": ["theme", "blue", "green", "orange", "red", "purple"], "default": "theme"},
  "binary-markdown.enableDebugLogging": {"type": "boolean", "default": false},
  "binary-markdown.export.pdfWhiteBackground": {"type": "boolean", "default": true},
  "binary-markdown.export.pandocPath": {"type": "string", "default": "", "scope": "machine"},
  "binary-markdown.export.browserPath": {"type": "string", "default": "", "scope": "machine"},
  "binary-markdown.math.backslashDelimiters": {"type": "boolean", "default": true},
  "binary-markdown.export.showCodeLanguage": {"type": "boolean", "default": true, "scope": "resource"},
  "binary-markdown.tableToolbarPosition": {"type": "string", "enum": ["auto", "top-left", "top-right", "bottom-left", "bottom-right", "left", "right", "top-bar"], "default": "auto", "scope": "window"},
  "binary-markdown.editorWidthMode": {"type": "string", "enum": ["default", "full", "custom"], "default": "default"},
  "binary-markdown.editorMaxWidth": {"type": "integer", "default": 860, "minimum": 320, "maximum": 4000},
  "binary-markdown.editorAlignment": {"type": "string", "enum": ["left", "center", "right"], "default": "center"},
  "binary-markdown.editorWidthIndicators": {"type": "boolean", "default": true},
  "binary-markdown.codeBlockActionLabels": {"type": "boolean", "default": true, "scope": "window"},
  "binary-markdown.codeLanguageOrder": {"type": "string", "enum": ["default", "a-z", "z-a"], "default": "default", "scope": "window"},
  "binary-markdown.mathSourcePosition": {"type": "string", "enum": ["above", "below"], "default": "above", "scope": "window"},
  "binary-markdown.mathSourceWrap": {"type": "boolean", "default": false, "scope": "window"},
  "binary-markdown.export.codeLanguagePosition": {"type": "string", "enum": ["top-left", "top-right", "bottom-left", "bottom-right"], "default": "top-left", "scope": "resource"},
  "binary-markdown.export.showCodeLineCount": {"type": "boolean", "default": false, "scope": "resource"},
  "binary-markdown.export.showCodeLineNumbers": {"type": "boolean", "default": false, "scope": "resource"},
  "binary-markdown.tableSourceFormat": {"type": "string", "enum": ["aligned", "compact"], "default": "aligned", "scope": "resource"}
}
